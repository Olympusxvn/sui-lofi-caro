# Sui x Lofi Caro — copy to .env.local and fill in after deployment.
# NEVER commit .env.local. Never put a private key or mnemonic in this file.
# Network: "mainnet" by default per SPEC.md. Use "testnet" for the hackathon demo.
NEXT_PUBLIC_SUI_NETWORK=testnet
# Package ID of the deployed caro Move package (0x...).
NEXT_PUBLIC_PACKAGE_ID=
# Shared ProtocolConfig object ID created at publish time (0x...).
NEXT_PUBLIC_CONFIG_ID=
